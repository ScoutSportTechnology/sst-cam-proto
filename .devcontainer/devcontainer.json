{
  "name": "sst-cam-proto",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/sst-cam-proto",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "bufbuild.vscode-buf",
        "redhat.vscode-yaml",
        "drblury.protobuf-vsc"
      ]
    }
  },
  // Print the tool versions so a fresh container immediately confirms buf +
  // dart + protoc-gen-dart are on PATH.
  "postCreateCommand": "buf --version && dart --version && protoc-gen-dart --version"
}
